# APP
NODE_ENV=local
PORT=3000
BASE_URL=http://localhost:3000
NAME=food-delivery-backend

# Fill in local passwords before starting Compose.
LOCAL_MYSQL_ROOT_PASSWORD=

# DB (MySQL / Aurora 호환)
DB_HOST=localhost
DB_PORT=3306
DB_USER_NAME=test
DB_PASSWORD=
DB_DATABASE=coupang_dev
DB_TLS=false

# Redis (로컬은 TLS/AUTH 없음, dev_infra ElastiCache는 TLS/AUTH)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=900s
JWT_REFRESH_EXPIRATION=7d

# AWS
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=example-upload-bucket
# Optional CDN origin; leave empty for direct S3 URLs.
AWS_CDN_URL=
AWS_SES_SENDER_EMAIL=sender@example.com
